    ifstream inputFile("input.txt");
    ofstream outputFile("output.txt");
    int num;

    if (inputFile.is_open()) {
        while (inputFile >> num) {
            if (isEvenPerfectSquare(num)) {
                outputFile << num << endl;
            }
        }
        inputFile.close();
        outputFile.close();
    }
    return 0;
}
